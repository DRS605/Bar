# Configuración del despliegue en producción de Bar Query.
# Copia este archivo a «.env» y rellena los valores. El «.env» NO se sube a git.
#
#   cp .env.ejemplo .env   &&   nano .env

# Dominio (o subdominio) que apunta a la IP de este servidor. Sin http/https.
DOMINIO=carta.tubar.com

# Contraseña de la base de datos PostgreSQL. Pon una larga y aleatoria.
POSTGRES_PASSWORD=cambia-esto-por-una-contraseña-larga

# Clave secreta para firmar los tokens de sesión. Mínimo 32 caracteres, aleatoria.
# Puedes generar una con:  openssl rand -base64 48
JWT_CLAVE=cambia-esto-por-una-clave-aleatoria-de-32-caracteres-o-mas
